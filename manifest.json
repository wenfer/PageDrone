{
  "manifest_version": 3,
  "name": "自动签到助手",
  "version": "1.0.5",
  "description": "为各类网站配置自动化签到，支持 Cloudflare 等待、可视化步骤与自定义脚本、定时任务。",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "cookies",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "自动签到助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
