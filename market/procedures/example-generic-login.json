{
  "spec": "auto-checkin-procedure/1",
  "marketId": "example/generic-login",
  "version": "1.0.0",
  "updatedAt": "2026-08-07T00:00:00Z",
  "procedure": {
    "kind": "login",
    "name": "通用账号密码登录",
    "description": "打开登录页 → 输入用户名密码 → 点击登录 → 等待回到业务页。安装后请把选择器改成你目标站点的实际值。",
    "detect": {
      "loggedInSelector": ".avatar, .user-avatar, .user-name",
      "loggedInUrlIncludes": "/home",
      "loginUrlPattern": "/login",
      "notLoggedInKeywords": ["请登录", "登录后操作", "您需要登录"]
    },
    "steps": [
      { "type": "goto", "url": "https://example.com/login", "timeoutMs": 30000 },
      { "type": "waitFor", "selector": "input[name=username]", "timeoutMs": 15000 },
      { "type": "type", "selector": "input[name=username]", "text": "你的账号", "timeoutMs": 10000 },
      { "type": "type", "selector": "input[name=password]", "text": "你的密码", "timeoutMs": 10000 },
      { "type": "click", "selector": "button[type=submit]", "timeoutMs": 10000, "waitNavigation": true },
      { "type": "waitForUrl", "match": "/home", "timeoutMs": 30000 }
    ],
    "author": "auto-checkin",
    "homepage": "https://github.com/wenfer/auto-checkin-procedures",
    "version": "1.0.0"
  }
}
