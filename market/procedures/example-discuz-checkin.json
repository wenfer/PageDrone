{
  "spec": "auto-checkin-procedure/1",
  "procedure": {
    "kind": "checkin",
    "name": "Discuz! 论坛执行",
    "description": "通用 Discuz! 论坛每日执行：点击「执行」按钮，等待成功提示。选择器可能需要按站点调整。",
    "detect": {
      "successKeywords": ["执行成功", "已执行", "本次执行", "恭喜"],
      "failKeywords": ["失败", "请登录", "您还没有登录"]
    },
    "steps": [
      { "type": "click", "selector": "#kx sign, a[href*='dsu_paulsign'], a[href*='sign']", "timeoutMs": 15000, "waitNavigation": true },
      { "type": "waitForText", "selector": "body", "includes": "执行成功", "timeoutMs": 15000 }
    ],
    "script": "",
    "author": "auto-checkin",
    "homepage": "https://github.com/wenfer/auto-checkin-procedures",
    "version": "1.0.0"
  }
}
